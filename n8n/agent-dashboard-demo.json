    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Edit relayUrl to point at your webhook relay (server/), and edit the\n// agents/tasks below to whatever your real agents should be doing.\nconst relayUrl = \"http://localhost:4000\";\n\nconst agents = [\n  {\n    id: \"researcher\",\n    name: \"Researcher\",\n    role: \"Gathers source material\",\n    systemPrompt: \"You are a research agent. Gather and summarize the key facts needed for the task in a few concise bullet points.\",\n    taskTitle: \"Summarize competitor pricing for our top 3 competitors\",\n  },\n  {\n    id: \"reviewer\",\n    name: \"Reviewer\",\n    role: \"Checks facts and quality\",\n    systemPrompt: \"You are a reviewer agent. Check the given text for factual accuracy and clarity, and list any issues found.\",\n    taskTitle: \"Review last week's client report for accuracy\",\n  },\n  {\n    id: \"writer\",\n    name: \"Writer\",\n    role: \"Drafts the final output\",\n    systemPrompt: \"You are a writer agent. Draft clear, concise copy for the given brief.\",\n    taskTitle: \"Draft an outline for the Q3 newsletter\",\n  },\n];\n\nconst now = Date.now();\nreturn agents.map((agent) => ({\n  json: {\n    ...agent,\n    taskId: `${agent.id}-${now}`,\n    relayUrl,\n    startedAt: now,\n  },\n}));"
      },
      "id": "3fb05b78-e0ba-43f5-bd77-763367948409",
      "name": "Define Agents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Define Agents').item.json.relayUrl }}/webhook/agent-event",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'agent_status', agent: { id: $('Define Agents').item.json.id, name: $('Define Agents').item.json.name, role: $('Define Agents').item.json.role, status: 'running', currentTask: $('Define Agents').item.json.taskTitle, updatedAt: Date.now() } }) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "7109ded0-997e-4a95-9343-1b76e9802a41",
      "name": "Notify: Agent Running",
