PORT=4000
# Shared secret n8n must send as `Authorization: Bearer <secret>`.
# Leave unset only for local development — required once this is reachable
# from outside localhost.
WEBHOOK_SECRET=
# Origin allowed to open the /events SSE stream (your dashboard's URL).
CORS_ORIGIN=http://localhost:5173
# Where event history is persisted so it survives a restart.
HISTORY_FILE=./data/history.json
